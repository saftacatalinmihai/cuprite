<li id="todo-{{id}}" {{#completed}}class="completed"{{/completed}}>
    <div class="view">
        <input 
            class="toggle" 
            type="checkbox" 
            hx-vals='js:{completed: this.checked}' 
            hx-patch="/todos/{{id}}" 
            hx-target="#todo-{{id}}" 
            hx-swap="outerHTML" 
            {{#completed}}checked{{/completed}}>
        <label ondblclick="enterEditMode(this)">{{text}}</label>
        <button class="destroy" hx-delete="/todos/{{id}}" hx-target="body" hx-swap="outerHTML"></button>
    </div>
    <input 
        class="edit" 
        value="{{text}}"
        onkeydown="handleEditKeydown(event, this)"
        onblur="exitEditMode(this)">
</li>