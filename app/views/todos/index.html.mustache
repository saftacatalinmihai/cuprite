<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>Cuprite • TodoMVC</title>
		<link rel="stylesheet" href="css/index.css">
	</head>
	<body>
		<section class="todoapp">
			<header class="header">
				<h1>todos</h1>
				<input class="new-todo"
					hx-on::before-request='this.value=""'
					hx-post="/todos" 
					hx-vals='js:{text: this.value}' 
					hx-patch="/todos/{{id}}" 
					hx-target=".todo-list" 
					hx-swap="afterbegin" 
					placeholder="What needs to be done?" 
					autofocus>
			</header>
			<!-- This section should be hidden by default and shown when there are todos -->
			<section class="main">
				
				<script>
					function toggleAll(event) {
						$$('.todo-list input[type=checkbox]').forEach(todo_checkbox => { 
							if (todo_checkbox.checked != event.target.checked) {
								todo_checkbox.checked = event.target.checked; 
								todo_checkbox.dispatchEvent(new Event('change')); // This will trigger the hx-patch request on the todo
							}
						});
					}
				</script>
				<input id="toggle-all" class="toggle-all" type="checkbox" onClick="toggleAll(event)">

				<label for="toggle-all">Mark all as complete</label>
				<ul class="todo-list">
					<!-- These are here just to show the structure of the list items -->
					<!-- List items should get the class `editing` when editing and `completed` when marked as completed -->
					{{#todos}}
						{{> todo.html}}
					{{/todos}}
				</ul>
			</section>
			<!-- This footer should be hidden by default and shown when there are todos -->
			<footer class="footer">
				<span class="todo-count"><strong id="todoCount">{{remaining_count}}</strong> item left</span>
				<script>
					function updateTodoCount() { 
						todoCount.innerHTML = $$('.todo-list input[type="checkbox"]:not(:checked)').length 
					}
					new MutationObserver(updateTodoCount).observe( $('.todo-list'), { childList: true, subtree: true, attributes: true } );
				</script>
				<!-- Remove this if you don't implement routing -->
				<ul class="filters">
					<script>
						function filterOnly(filter) {
							$$('.filters a').forEach(e => e.classList.remove("selected"))
							$("#filter-" + filter).classList.add("selected")
							$$('.todo-list > li').forEach(todo => {
								todo.hidden = false;
								if (filter == "active" && todo.className == "completed") { todo.hidden = true }
								if (filter == "completed" && todo.className != "completed") { todo.hidden = true }
							})
						}
					</script>
					<li>
						<a id="filter-all" href="#/" onClick='filterOnly("all")' class="selected">All</a>
					</li>
					<li>
						<a id="filter-active" href="#/active" onClick='filterOnly("active")'>Active</a>
					</li>
					<li>
						<a id="filter-completed" href="#/completed" onClick='filterOnly("completed")'>Completed</a>
					</li>
				</ul>
				<button class="clear-completed" hx-delete="/todos" hx-target="body" hx-swap="outerHTML">Clear completed</button>
			</footer>
		</section>
		<footer class="info">
			<p>Double-click to edit a todo</p>
			<!-- Remove the below line ↓ -->
			<p>Template by <a href="http://sindresorhus.com">Sindre Sorhus</a></p>
			<!-- Change this out with your name and url ↓ -->
			<p>Created by <a href="http://todomvc.com">you</a></p>
			<p>Part of <a href="http://todomvc.com">TodoMVC</a></p>
		</footer>
	</body>
</html>