<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>Template • TodoMVC</title>
		<link rel="stylesheet" href="css/index.css">
	</head>
	<body>
		<section class="todoapp">
			<header class="header">
				<h1>todos</h1>
				<input class="new-todo" 
				hx-post="/todos" 
				hx-vals='js:{text: this.value}' 
            	hx-patch="/todos/{{id}}" 
				hx-target="body" 
            	hx-swap="outerHTML" 
				placeholder="What needs to be done?" 
				autofocus>
			</header>
			<!-- This section should be hidden by default and shown when there are todos -->
			<section class="main">
				<input id="toggle-all" class="toggle-all" type="checkbox" 
					hx-patch="/todos" 
					hx-target="body" 
					hx-swap="outerHTML">
				<label for="toggle-all">Mark all as complete</label>
				<ul class="todo-list">
					<!-- These are here just to show the structure of the list items -->
					<!-- List items should get the class `editing` when editing and `completed` when marked as completed -->
					{{#todos}}
						{{> todo.html}}
					{{/todos}}
				</ul>
			</section>
			<!-- This footer should be hidden by default and shown when there are todos -->
			<footer class="footer">
				<span class="todo-count"><strong id="todo-count">{{remaining_count}}</strong> item left</span>
				<script>
					// This reacts to the checkbox check or uncheck event which does not reload the whole page.
					// When we delete an entire todo or add a new one, the whole page is reloaded, and the template gives the remaining_count from the backend.
					$(".todo-list").addEventListener("change", () => {
						$("#todo-count").innerHTML = $$('.todo-list input[type="checkbox"]:not(:checked)').length;
					})
				</script>
				<!-- Remove this if you don't implement routing -->
				<ul class="filters">
					<script>
						function filterOnly(filter) {
							$$('.filters a').forEach(e => e.classList.remove("selected"))
							$("#filter-" + filter).classList.add("selected")
							$$('.todo-list > li').forEach(todo => {
								todo.hidden = false;
								if (filter == "active" && todo.className == "completed") {
									todo.hidden = true;
								}
								if (filter == "completed" && todo.className != "completed") {
									todo.hidden = true;
								}
							})
						}
					</script>
					<li>
						<a id="filter-all" href="#/" onClick='filterOnly("all")' class="selected">All</a>
					</li>
					<li>
						<a id="filter-active" href="#/active" onClick='filterOnly("active")'>Active</a>
					</li>
					<li>
						<a id="filter-completed" href="#/completed" onClick='filterOnly("completed")'>Completed</a>
					</li>
				</ul>
				<!-- Hidden if no completed items are left ↓ -->
				<button class="clear-completed">Clear completed</button>
			</footer>
		</section>
		<footer class="info">
			<p>Double-click to edit a todo</p>
			<!-- Remove the below line ↓ -->
			<p>Template by <a href="http://sindresorhus.com">Sindre Sorhus</a></p>
			<!-- Change this out with your name and url ↓ -->
			<p>Created by <a href="http://todomvc.com">you</a></p>
			<p>Part of <a href="http://todomvc.com">TodoMVC</a></p>
		</footer>
	</body>
</html>